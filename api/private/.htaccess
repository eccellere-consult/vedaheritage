# Protected folder for server settings (vh-config.php) and private data (data/), used when the host does not let PHP
# read or write above the web folder. NOTHING in here is ever served to visitors.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
